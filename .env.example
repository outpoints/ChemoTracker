# Copy to .env (git-ignored) and adjust. Every value is optional.

# Time zone used for dose times and the 3 AM backup. Use your IANA zone name.
TZ=America/Los_Angeles

# Family password. Strongly recommended if anyone besides you can reach the port.
# CHEMO_PASSWORD=choose-something-long

# Port on the host.
# CHEMO_PUBLISH_PORT=8000

# Backups: host folder (an external drive or synced folder works well), schedule, and how many to keep.
# CHEMO_BACKUP_HOST_DIR=./backups
# CHEMO_BACKUP_TIME=03:00
# CHEMO_BACKUP_INTERVAL_HOURS=24
# CHEMO_BACKUP_KEEP=30
# CHEMO_BACKUP_ENABLED=1

# Session signing key. Generated into data/.secret_key automatically when unset.
# CHEMO_SECRET_KEY=

# Container user. On Linux, match the owner of ./data and the backup folder (`id -u`, `id -g`).
# CHEMO_UID=1000
# CHEMO_GID=1000

# Copy to .env (git-ignored) and adjust. Every value is optional.

# Time zone used for dose times and the 3 AM backup. Use your IANA zone name.
TZ=America/Los_Angeles

# Optional family password. Leave it out and there's no sign-in screen.
# Worth setting if people outside your household can reach the port.
# CHEMO_PASSWORD=choose-something-long

# Port on the host, and which address it listens on (0.0.0.0 = home network, 127.0.0.1 = this computer only).
# Use your home network or Tailscale. Never forward this port to the open internet (see SECURITY.md).
# CHEMO_PUBLISH_PORT=8000
# CHEMO_BIND=0.0.0.0

# Only answer these names and addresses (blocks DNS rebinding). Unset = any name works.
# CHEMO_ALLOWED_HOSTS=chemo.example.com,192.168.1.20

# Set to 1 when the app is only reached over HTTPS (tailscale serve or a reverse proxy with a certificate).
# CHEMO_SECURE_COOKIE=1

# Behind a reverse proxy: the proxy's address, so sign-in limits apply per visitor, not to the proxy.
# CHEMO_FORWARDED_ALLOW_IPS=127.0.0.1

# Where the database lives on this computer. Default ./data next to compose.yaml. On a NAS, point it at a
# folder on the NAS's own volume, e.g. /volume1/docker/chemotracker/data. Create the folder first.
# Don't use a network share (SMB/NFS) mounted from another computer: SQLite can't lock files there safely.
# CHEMO_DATA_HOST_DIR=./data

# Backups: host folder (an external drive or synced folder works well), schedule, and how many to keep.
# CHEMO_BACKUP_HOST_DIR=./backups
# CHEMO_BACKUP_TIME=03:00
# CHEMO_BACKUP_INTERVAL_HOURS=24
# CHEMO_BACKUP_KEEP=30
# CHEMO_BACKUP_ENABLED=1

# Session signing key. Generated into data/.secret_key automatically when unset.
# CHEMO_SECRET_KEY=

# Run a published release instead of building from this folder. Use a version number, then
# `docker compose pull` and `docker compose up -d`. Unset = build here (`docker compose up -d --build`).
# CHEMO_IMAGE=ghcr.io/outpoints/chemotracker:0.7.1

# Container user. On Linux, match the owner of the data and backup folders (`id -u`, `id -g`).
# CHEMO_UID=1000
# CHEMO_GID=1000
